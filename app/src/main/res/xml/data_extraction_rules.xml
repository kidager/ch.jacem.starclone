<?xml version="1.0" encoding="utf-8"?>
<!-- For API 31+: controls what Android Auto Backup and device transfer includes -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="rclone.conf" />
        <include domain="file" path="rclone.conf.enc" />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="rclone.conf" />
        <include domain="file" path="rclone.conf.enc" />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
